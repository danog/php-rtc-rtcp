{
    "name": "danog/php-rtc-rtcp",
    "type": "library",
    "description": "Pure-PHP RTCP packet parsing and generation. MadelineProto's PHP 8.2+ fork fixes unsigned NTP handling and integrates with the modular danog/php-rtc stack.",
    "keywords": [
        "rtp",
        "rtcp"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.2",
        "danog/php-rtc-exception": "^1.0"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\RTCP\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\RTCP\\": "tests"
        }
    },
    "minimum-stability": "dev"
}
